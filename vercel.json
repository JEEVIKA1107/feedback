{
  "version": 2,
  "buildCommand": "cd feedback/client && npm install && npm run build",
  "outputDirectory": "feedback/client/dist",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
